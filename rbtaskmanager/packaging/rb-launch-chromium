#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-only OR LicenseRef-RB-Commercial
# rb-launch-chromium URL  -> kiosk app window on Wayland.
# The Wayland app-id is derived from the URL, e.g.
#   http://192.168.10.1/RB-01  ->  chrome-192.168.10.1__RB-01-Default
# Window placement on first start comes from [window-rules] in wayfire.ini.
BROWSER=$(command -v chromium || command -v chromium-browser)
[ -n "$BROWSER" ] || { echo "rb-launch-chromium: chromium not found" >&2; exit 1; }
exec "$BROWSER" --kiosk --ozone-platform=wayland --app="$1"
